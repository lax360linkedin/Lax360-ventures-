# LAX360 Ventures backend configuration. Copy to backend/.env and fill in the values.
# This file contains placeholders only and is safe to commit. NEVER commit backend/.env.

# ---- Application -------------------------------------------------------------------------
APP_ENV=development            # development | test | production
PORT=8000                      # used by your process manager / `uvicorn --port`
LOG_LEVEL=INFO
LOG_JSON=false                 # true = one JSON object per log line (recommended in production)
# DOCS_ENABLED=                # blank = on in development, off in production. Set true/false to override.
TRUST_PROXY_HEADERS=false      # true ONLY behind a reverse proxy you control (uses X-Forwarded-For for rate limits)
MAX_REQUEST_BODY_BYTES=65536
MEDIA_MAX_BYTES=10485760       # largest image/PDF an admin can upload (videos: HERO_VIDEO_MAX_BYTES)
MEDIA_BUCKET=site-media        # Supabase Storage bucket for the media library (created public automatically)

# ---- Frontend / CORS ---------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated, explicit origins only (credentials are used, so * is rejected). Use https:// in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Database: Supabase PostgreSQL (REQUIRED) ----------------------------------------------
# Used directly through the PostgreSQL driver (SQLAlchemy + psycopg 3). The database never uses the Supabase HTTP API or its keys.
# (Only the optional homepage-video storage below uses SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.) Copy the string from Supabase: your project -> Connect.
#   Local development / migrations: "Session pooler" (port 5432) — or "Direct connection" if your network has IPv6.
#   Avoid the "Transaction pooler" (port 6543) for migrations; if you do use it, prepared statements are turned off automatically.
# Format: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23). SSL is added automatically for Supabase hosts.
DATABASE_URL=
DB_POOL_SIZE=5                 # keep small: Supabase limits concurrent connections per plan
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# DB_DISABLE_PREPARED_STATEMENTS=   # blank = automatic (disabled only for port 6543); true/false to force

# ---- Authentication ----------------------------------------------------------------------
# Random secret, >= 32 characters. Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
SESSION_TTL_MINUTES=720
SESSION_COOKIE_NAME=lax360_session
# blank = Secure cookies in production, off otherwise. Must be true in production.
COOKIE_SECURE=
# lax works when the site and API share a registrable domain (e.g. same origin via a proxy). Use none ONLY for a
# cross-site API (requires COOKIE_SECURE=true) — see README "Deployment".
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
MIN_PASSWORD_LENGTH=8

# ---- Initial Super Admin (placeholders only: put the real values in backend/.env, never here) ------
# On server start (or `python -m app.cli provision-admin`) the account is created ONCE. Log in with the email OR the username.
# While ADMIN_PASSWORD is empty NO account is created. An existing account's password is never changed implicitly.
# After the account exists you may remove ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=superadmin
# ADMIN_PASSWORD: choose a strong password (8+ characters); leave empty until you are ready.
ADMIN_PASSWORD=

# ---- AI provider (backend only — NEVER put any key in a VITE_ variable) -------------------
# Which provider answers chat. Exactly one is used; the app never silently switches to the other.
AI_PROVIDER=gemini             # gemini | openai
# Gemini (Google Gen AI SDK). Key: https://aistudio.google.com/apikey  Model: https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=                  # the model id YOU choose; no default is assumed
# OpenAI (only needed when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=                  # the model id YOU choose; no default is assumed
# Shared by both providers
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1               # bounded retries (OpenAI SDK)

# ---- Chatbot behaviour and limits --------------------------------------------------------
CHAT_MAX_INPUT_CHARS=1000
CHAT_MAX_OUTPUT_TOKENS=500
CHAT_CONTEXT_MESSAGES=10
CHAT_MAX_MESSAGES_PER_SESSION=40
CHAT_RETENTION_DAYS=30
# Application-side daily token budget (0 = off). Complements, does NOT replace, spending limits in your AI provider account.
CHAT_DAILY_TOKEN_BUDGET=0

# ---- Rate limiting (per client IP, in memory per process) ------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
DEMO_RATE_LIMIT_MAX=10
DEMO_RATE_LIMIT_WINDOW_SECONDS=3600
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Email ---------------------------------------------------------------------------------
# Email delivery is NOT implemented. Enquiries and demo requests are stored in PostgreSQL only, and the
# website never claims an email was sent.

# ---- Homepage background videos ------------------------------------------------------------------
# Videos: in production they MUST be in Supabase Storage (Render's disk is wiped on restart/redeploy): set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Without them videos fall back to DISK (development only). HERO_VIDEO_BUCKET names the (public) storage bucket.
APP_TIMEZONE=Asia/Kolkata          # every schedule is calculated and shown in this timezone
HERO_VIDEO_DIR=storage/hero_videos
HERO_VIDEO_MAX_BYTES=52428800      # 50 MB
# HERO_VIDEO_SLOT_SECONDS=120      # development/test ONLY: replaces the 3-day slot so rotation can be watched in minutes

# ---- Company-admin sessions (separate cookie from the public website's) ---------------------------
ADMIN_SESSION_COOKIE_NAME=lax360_admin_session
ADMIN_SESSION_TTL_MINUTES=480
REGISTER_RATE_LIMIT_MAX=5            # public sign-ups per IP per window
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
