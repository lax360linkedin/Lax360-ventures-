{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lax360-ventures.onrender.com/api/:path*"
    },
    {
      "source": "/services/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/company-admin",
      "destination": "/index.html"
    },
    {
      "source": "/company-admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/user",
      "destination": "/index.html"
    },
    {
      "source": "/user/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    }
  ]
}
