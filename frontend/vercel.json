  "rewrites": [
    {
      "source": "/sitemap-content.xml",
      "destination": "https://lax360-ventures.onrender.com/api/public/sitemap-content.xml"
    },
    {
      "source": "/locations/:slug([a-z0-9-]{1,80})",
      "destination": "/index.html"
    },
    {
      "source": "/play-zone",
      "destination": "/index.html"
    },
    {
      "source": "/play-zone/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:lang(ta|hi)/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://lax360-ventures.onrender.com/api/:path*"
    },
    {
      "source": "/services/:slug([a-z0-9-]{1,80})",
      "destination": "/index.html"
    },
    {
      "source": "/company-admin",
      "destination": "/index.html"
    },
    {
      "source": "/company-admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
