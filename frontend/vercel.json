        }
      ],
      "destination": "https://lax360.in/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/|_vercel/).*)",
      "has": [
        {
          "type": "host",
          "value": "lax360-ventures.vercel.app"
        }
      ],
      "destination": "https://lax360.in/$1",
      "permanent": true
    }
