# Public (browser-visible) values only. NEVER put secrets in a VITE_ variable.
VITE_SITE_URL=https://www.example.com
VITE_WHATSAPP_NUMBER=919566679958
# Base URL of the FastAPI backend. Leave EMPTY to call the same origin (/api/...): Vite proxies it to localhost:8000 in
# development, and a reverse proxy can route /api in production. URL only — never a secret (see backend/.env.example).
VITE_API_BASE_URL=
