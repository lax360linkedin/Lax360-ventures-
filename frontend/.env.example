# Public (browser-visible) values only. NEVER put secrets in a VITE_ variable.
# The real public address of the website (no trailing slash). REQUIRED for production: canonical links, the sitemap, robots.txt and social previews are built from it.
VITE_SITE_URL=https://lax360-ventures.vercel.app
VITE_WHATSAPP_NUMBER=919566679928
# Base URL of the FastAPI backend. Leave EMPTY to call the same origin (/api/...): Vite proxies it to localhost:8000 in
# development, and a reverse proxy can route /api in production. URL only — never a secret (see backend/.env.example).
# Leave EMPTY when the website serves /api itself (dev proxy, a reverse proxy, or the rewrite in vercel.json). Only set it for an API on a
# different host, and then the API and website must be the same site (e.g. www.example.com + api.example.com) or use COOKIE_SAMESITE=none.
VITE_API_BASE_URL=

# --- SEO & analytics (all public values; everything is OFF until set; see SEO_REPORT.md) ---
# Google Search Console: the content of the verification meta tag (HTML tag method), e.g. abcDEF123...
VITE_GSC_VERIFICATION=
# Bing Webmaster Tools verification code (optional)
VITE_BING_VERIFICATION=
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Use this OR a Tag Manager container.
VITE_GA_MEASUREMENT_ID=
# Google Tag Manager container (GTM-XXXXXXX). When set, events go to the dataLayer and GA4 is configured inside the container.
VITE_GTM_ID=
